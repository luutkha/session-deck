{
  "name": "session-deck",
  "version": "0.0.3",
  "description": "Desktop app to run and manage many Claude Code sessions",
  "type": "module",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "node scripts/patch-node-pty.mjs && electron-builder install-app-deps",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run",
    "icons": "electron scripts/make-icons.cjs",
    "icons:check": "node scripts/check-icons.cjs",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win",
    "e2e:packaged": "node scripts/e2e-packaged.cjs",
    "e2e": "node scripts/e2e.cjs",
    "e2e:resume": "node scripts/e2e-resume.cjs",
    "e2e:g1": "node scripts/e2e-g1.cjs",
    "e2e:imagepaste": "node scripts/e2e-imagepaste.cjs",
    "e2e:paste": "node scripts/e2e-paste.cjs",
    "e2e:close": "node scripts/e2e-close.cjs",
    "e2e:dialogs": "node scripts/e2e-dialogs.cjs",
    "e2e:robust": "node scripts/e2e-robust.cjs",
    "e2e:busyclose": "node scripts/e2e-busy-close.cjs",
    "e2e:hub": "node scripts/e2e-hub.cjs",
    "e2e:notes": "node scripts/e2e-notes-usage.cjs",
    "e2e:usage-refresh": "node scripts/e2e-usage-refresh.cjs",
    "e2e:sleepall": "node scripts/e2e-sleepall.cjs",
    "e2e:sleepbell": "node scripts/e2e-sleepbell.cjs",
    "e2e:palette": "node scripts/e2e-palette.cjs",
    "e2e:away": "node scripts/e2e-away.cjs",
    "e2e:autopilot": "node scripts/e2e-autopilot.cjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.577.0",
    "node-pty": "^1.1.0-beta22",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.6"
  }
}
